{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ConnectionProvider": "Host=localhost;Port=5430;Database=moderation_service_db;Username=postgres;Password=postgres;"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "rmuser",
    "Password": "rmpassword"
  },
  "ModerationResultPublisher": {
    "DelaySeconds": 5
  },
  "ProcessedMessagesCleanup": {
    "RetentionDays": 7,
    "IntervalHours": 1
  },
  "ErrorQueueMonitor": {
    "QueueName": "PostSubmittedForModeration_error",
    "UserName": "rmuser",
    "Password": "rmpassword",
    "ManagementApiUrl": "http://localhost:15672",
    "IntervalMinutes": 5
  }
}
