{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "MassTransit": "Debug"
      }
    },
    "Filter": [
      {
        "Name": "ByIncludingOnly",
        "Args": {
          "expression": "(SourceContext is null or not Contains(SourceContext, 'MassTransit')) or Contains(@m, 'SEND') or Contains(@m, 'RECEIVE') or Contains(@m, 'SKIP') or Level >= Error"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "ConnectionStrings": {
    "ConnectionProvider": "Host=host.docker.internal;Port=5430;Database=moderation_service_db;Username=postgres;Password=postgres;"
  },
  "RabbitMQ": {
    "Host": "host.docker.internal",
    "Port": 5672,
    "UserName": "rmuser",
    "Password": "rmpassword"
  },
  "ModerationResultPublisher": {
    "DelaySeconds": 5
  },
  "ProcessedMessagesCleanup": {
    "RetentionDays": 7,
    "IntervalHours": 1
  },
  "ErrorQueueMonitor": {
    "QueueName": "PostSubmittedForModeration_error",
    "UserName": "rmuser",
    "Password": "rmpassword",
    "ManagementApiUrl": "http://localhost:15672",
    "IntervalMinutes": 5
  }
}
